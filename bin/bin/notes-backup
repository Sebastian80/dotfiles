#!/usr/bin/env bash
# notes-backup - Copy ~/notes to Google Drive (folder "notes") with rclone
# Usage: notes-backup [--dry-run]
#
# ~/notes is in no git repo and was lost in the 2026-09-30 reinstall; it names customers,
# so it stays out of the public dotfiles. `rclone copy` only uploads new and changed
# files and never deletes anything on Drive. One-time setup: `rclone config`, new remote
# named "gdrive" of type "drive", signed in with the Netresearch Google account.

set -euo pipefail

REMOTE="gdrive"
SRC="$HOME/notes"
DEST="$REMOTE:notes"

case "${1:-}" in
    -h | --help)
        sed -n '2,8p' "$0" | cut -c3-
        exit 0
        ;;
    --dry-run | "") ;;
    *)
        echo "notes-backup: unknown option $1 (see --help)" >&2
        exit 2
        ;;
esac

command -v rclone >/dev/null 2>&1 || { echo "notes-backup: rclone is not installed (brew install rclone)" >&2; exit 1; }
rclone listremotes | grep -qx "$REMOTE:" || { echo "notes-backup: no rclone remote \"$REMOTE\"; run: rclone config" >&2; exit 1; }
[ -d "$SRC" ] || { echo "notes-backup: $SRC does not exist" >&2; exit 1; }

rclone copy "$SRC" "$DEST" ${1:+"$1"} --stats-one-line --stats-log-level NOTICE --log-level NOTICE
echo "notes-backup: $SRC -> $DEST done"
