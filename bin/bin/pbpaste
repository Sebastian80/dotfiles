#!/usr/bin/env bash
# Print the clipboard to stdout under the macOS name; counterpart of pbcopy.
# Wayland uses wl-paste, X11 falls back to xclip.
#   pbpaste
set -euo pipefail
case "${1:-}" in
  -h|--help) echo "usage: pbpaste   print the clipboard to stdout"; exit 0 ;;
esac

if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null; then
  exec wl-paste --no-newline
elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null; then
  exec xclip -selection clipboard -o
fi
echo "pbpaste: no clipboard tool for this session (brew install wl-clipboard)" >&2
exit 1
