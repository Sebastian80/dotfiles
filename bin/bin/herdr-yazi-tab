#!/usr/bin/env bash
# Open yazi (herdr plugin ray.file-explorer) in a new herdr tab named "yazi", at the
# directory of the pane that has UI focus, and focus that tab.
# Bound to prefix+alt+e in ~/.config/herdr/config.toml as a type = "shell" command.
set -euo pipefail
usage() { echo "usage: herdr-yazi-tab [-h]  -- open yazi in a focused herdr tab named yazi"; }
[ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] && { usage; exit 0; }

dir="$(herdr pane current | jq -r '.result.pane.foreground_cwd // .result.pane.cwd')"
[ -d "$dir" ] || dir="$HOME"
out="$(herdr plugin pane open --plugin ray.file-explorer --entrypoint explorer \
        --placement tab --cwd "$dir" --focus)"
tab="$(jq -r '.result.plugin_pane.pane.tab_id // empty' <<<"$out")"
[ -n "$tab" ] || { echo "herdr-yazi-tab: no tab id in response: $out" >&2; exit 1; }
herdr tab rename "$tab" yazi >/dev/null
herdr tab focus "$tab" >/dev/null
