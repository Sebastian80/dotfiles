#!/usr/bin/env bash
# phpstorm-background - open a project in PhpStorm without taking keyboard focus
# Usage: phpstorm-background <project root>
#
# PhpStorm has no launch option to stay in the background, and the JetBrains launcher raises the
# project window whether it starts the IDE or reuses a running one. So this starts the launcher and,
# while PhpStorm comes up, minimizes every PhpStorm window that grabs focus and gives focus back to
# the window that had it. X11 only (xdotool, wmctrl, xprop).
#
# Exits once the index MCP port answers and no PhpStorm window has taken focus for QUIET seconds,
# or after TIMEOUT seconds. Exit 0 when the port answers, 1 when it never did.
#
# Env: PHPSTORM_LAUNCHER (default: the Toolbox script), IDE_INDEX_PORT (29175),
#      TIMEOUT (120), QUIET (8)

set -u

[ $# -eq 1 ] && [ -d "$1" ] || { echo "usage: phpstorm-background <project root>" >&2; exit 2; }
PROJECT=$(cd "$1" && pwd)
LAUNCHER="${PHPSTORM_LAUNCHER:-$HOME/.local/share/JetBrains/Toolbox/scripts/phpstorm}"
PORT="${IDE_INDEX_PORT:-29175}"
TIMEOUT="${TIMEOUT:-120}"
QUIET="${QUIET:-8}"

prev=$(xdotool getactivewindow 2>/dev/null || true)
setsid nohup "$LAUNCHER" "$PROJECT" >/dev/null 2>&1 < /dev/null &

is_phpstorm() {
  xprop -id "$1" WM_CLASS 2>/dev/null | grep -q '"jetbrains-phpstorm"'
}

start=$SECONDS
last_grab=$SECONDS
port_up=no
while [ $((SECONDS - start)) -lt "$TIMEOUT" ]; do
  win=$(xdotool getactivewindow 2>/dev/null || true)
  if [ -n "$win" ] && [ "$win" != "$prev" ] && is_phpstorm "$win"; then
    xdotool windowminimize "$win" 2>/dev/null
    [ -n "$prev" ] && xdotool windowactivate "$prev" 2>/dev/null
    last_grab=$SECONDS
  fi
  if [ "$port_up" = no ] && curl -s -m 1 -o /dev/null "http://127.0.0.1:${PORT}/"; then
    port_up=yes
  fi
  if [ "$port_up" = yes ] && [ $((SECONDS - last_grab)) -ge "$QUIET" ]; then
    exit 0
  fi
  sleep 0.2
done

[ "$port_up" = yes ]
