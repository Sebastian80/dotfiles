#!/usr/bin/env bash
# Launch Herdr in its chromeless Ghostty window (profile ~/.config/ghostty/herdr), or focus
# that window when it is already open: a second Ghostty launch would hand off to the live
# instance and attach another herdr client in a new window. Ghostty maximizes the window
# itself (maximize = true in the profile). Target of herdr.desktop.
#   herdr-launch [-h]
#
# The open window is found through KWin's window runner, the D-Bus backend of KRunner's
# window search, since Wayland gives clients no way to list or raise other windows. The
# profile pins the caption to "Herdr"; the runner matches substrings of captions and app
# names, so only an exact caption match counts.
set -euo pipefail
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "usage: herdr-launch   open (or focus) the maximized Herdr Ghostty window"; exit 0
fi
profile="$HOME/.config/ghostty/herdr"
title="Herdr"

runner() {
  gdbus call --session --dest org.kde.KWin --object-path /WindowsRunner \
    --method "org.kde.krunner1.$1" "${@:2}"
}

# Prints the runner's match id for the open Herdr window, e.g. 0_{uuid}.
find_window() {
  runner Match "$title" 2>/dev/null | grep -oE "\('[^']+', '$title'," | head -1 | cut -d"'" -f2
}

if win="$(find_window)" && [ -n "$win" ]; then
  runner Run "$win" "" >/dev/null
  exit 0
fi

# Started from inside a Herdr pane, these would make the new client refuse to nest.
unset HERDR_BIN_PATH HERDR_ENV HERDR_PANE_ID HERDR_SOCKET_PATH HERDR_TAB_ID HERDR_WORKSPACE_ID
setsid ghostty --config-file="$profile" >/dev/null 2>&1 < /dev/null &
