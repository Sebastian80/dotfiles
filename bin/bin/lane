#!/usr/bin/env bash
#
# lane - Run one pi or Claude worker on a task in a pane, a tab or headless, and wait for it.
#
# Usage:
#   lane [options] TASK
#   lane [options] --cmd 'COMMAND'
#   lane -h
#
# TASK is a brief file, which the worker is told to read and follow, or literal prompt text.
# --cmd runs an interactive command in the pane instead of starting an agent, for example
# 'crawl --tui "question"'.
#
# Placement and lifecycle:
#   --where pane|tab|headless   Split next to the calling pane (default), open a tab in the
#                               caller's workspace, or run without a terminal
#   --split right|down          Split direction for --where pane (default right)
#   --close keep|auto|on-success
#                               Leave the pane or tab open (default), close it once the worker is
#                               idle, or close it only when the task succeeded. A worker blocked on
#                               a question and a worker still running at the timeout stay open.
#
# Worker:
#   --kind pi|claude            Agent to start (default pi)
#   --model M                   Default: openai-codex/gpt-5.6-terra for pi, opus for claude
#   --effort L                  pi thinking level or claude effort (default: medium for pi, high
#                               for claude)
#   --name NAME                 Agent name (default <kind>-HHMMSS)
#   --cwd DIR                   Worker directory (default: the current directory)
#   --report FILE               File the task makes the worker write. With it, success means the
#                               file was written during this run; without it, the worker going idle.
#   --timeout MIN               Stop waiting after MIN minutes (default 60); the worker keeps running
#   -- ARGS...                  Extra pi or claude CLI arguments (tool allowlists, permission mode)
#
# lane blocks until the worker settles, so an agent session runs it as a background task: the task
# finishing is its notification. The final screen or headless output lands in ~/.cache/lane/<name>/.
# A Claude worker in a directory it has never trusted stops at the trust dialog and fails to start.
#
# Exit: 0 done, 1 failed or idle without its report, 2 usage error, 4 blocked on a question (left
# open for an answer), 5 timeout.
#
set -euo pipefail

usage() {
	awk 'NR > 2 && !/^#/ {exit} NR > 2 {sub(/^# ?/, ""); print}' "$0"
	exit "${1:-0}"
}
die() {
	echo "lane: $*" >&2
	exit 2
}

where=pane split=right close=keep kind=pi model="" effort="" name="" cwd="$PWD" report="" timeout_min=60
cmd="" task=""
extra=()
while [[ $# -gt 0 ]]; do
	case "$1" in
		-h | --help) usage ;;
		--where | --split | --close | --kind | --model | --effort | --name | --cwd | --report | --timeout | --cmd)
			[[ $# -ge 2 ]] || die "$1 needs a value"
			case "$1" in
				--where) where="$2" ;;
				--split) split="$2" ;;
				--close) close="$2" ;;
				--kind) kind="$2" ;;
				--model) model="$2" ;;
				--effort) effort="$2" ;;
				--name) name="$2" ;;
				--cwd) cwd="$2" ;;
				--report) report="$2" ;;
				--timeout) timeout_min="$2" ;;
				--cmd) cmd="$2" ;;
			esac
			shift 2
			;;
		--) shift; extra=("$@"); break ;;
		-*) echo "lane: unknown option $1" >&2; usage 2 ;;
		*) [[ -z "$task" ]] || die "only one TASK allowed"; task="$1"; shift ;;
	esac
done

[[ -n "$task" || -n "$cmd" ]] || usage 2
[[ -z "$task" || -z "$cmd" ]] || die "give a TASK or --cmd, not both"
[[ "$where" =~ ^(pane|tab|headless)$ ]] || die "--where must be pane, tab or headless"
[[ "$close" =~ ^(keep|auto|on-success)$ ]] || die "--close must be keep, auto or on-success"
[[ "$kind" =~ ^(pi|claude)$ ]] || die "--kind must be pi or claude"
[[ "$timeout_min" =~ ^[0-9]+$ ]] || die "--timeout takes whole minutes"
[[ -z "$cmd" || "$where" != headless ]] || die "--cmd needs a terminal, not --where headless"
[[ "$where" == headless || -n "${HERDR_PANE_ID:-}" ]] || die "--where $where needs to run inside herdr"

if [[ "$kind" == pi ]]; then
	model="${model:-openai-codex/gpt-5.6-terra}" effort="${effort:-medium}"
	cli_args=(--model "$model" --thinking "$effort")
	# A project with its own pi files makes pi ask for trust at startup, and that dialog swallows
	# the task. Project files stay ignored unless the caller passes -a.
	[[ " ${extra[*]} " =~ \ (-a|--approve)\  ]] || cli_args+=(-na)
else
	model="${model:-opus}" effort="${effort:-high}"
	cli_args=(--model "$model" --effort "$effort")
fi
cli_args+=("${extra[@]}")
name="${name:-$([[ -n "$cmd" ]] && echo cmd || echo "$kind")-$(date +%H%M%S)}"
cwd="$(realpath "$cwd")"
[[ -z "$report" ]] || report="$(realpath -m "$report")"

prompt="$task"
[[ -f "$task" ]] && prompt="Read $(realpath "$task") and carry out that task exactly as written."
[[ -z "$report" || -z "$task" ]] || prompt+=" When you are done, $report must exist."

out="${XDG_CACHE_HOME:-$HOME/.cache}/lane/$name"
mkdir -p "$out"
touch "$out/started"
start=$SECONDS

# Success needs a report written during this run, so a stale file from an earlier run never counts.
report_written() { [[ -z "$report" ]] || [[ -f "$report" && "$report" -nt "$out/started" ]]; }

if [[ "$where" == headless ]]; then
	rc=0
	if [[ "$kind" == pi ]]; then
		(cd "$cwd" && timeout "$((timeout_min * 60))" pi -p "${cli_args[@]}" -- "$prompt" \
			</dev/null >"$out/output.md" 2>"$out/stderr.log") || rc=$?
	else
		(cd "$cwd" && timeout "$((timeout_min * 60))" claude -p "${cli_args[@]}" -- "$prompt" \
			</dev/null >"$out/output.md" 2>"$out/stderr.log") || rc=$?
	fi
	state="done"
	[[ $rc -eq 0 ]] || state=failed
	[[ $rc -ne 124 ]] || state=timeout
	cat "$out/output.md"
else
	if [[ "$where" == pane ]]; then
		pane="$(herdr pane split --current --direction "$split" --cwd "$cwd" --no-focus | jq -r '.result.pane.pane_id')"
	else
		pane="$(herdr tab create --workspace "${HERDR_PANE_ID%%:*}" --cwd "$cwd" --label "$name" --no-focus |
			jq -r '.result.root_pane.pane_id')"
	fi
	tab="$(herdr pane get "$pane" | jq -r '.result.pane.tab_id')"

	deadline=$((SECONDS + timeout_min * 60))
	slice() {
		local s=$(((deadline - SECONDS) * 1000))
		((s < 600000)) || s=600000
		echo "$s"
	}

	seq0=""
	if [[ -n "$cmd" ]]; then
		herdr pane run "$pane" "$cmd" >/dev/null
		target="$pane"
		# The agent exists only once the command has started it. Its first turn counts only when the
		# state has changed since then, because the pane can still show idle from before that turn.
		for _ in $(seq 60); do
			seq0="$(herdr agent get "$pane" 2>/dev/null |
				jq -r 'select(.result.agent.agent != null) | .result.agent.state_change_seq' 2>/dev/null || true)"
			[[ -z "$seq0" ]] || break
			sleep 2
		done
		res=""
		[[ -n "$seq0" ]] || res='{"error":{"code":"no_agent_started"}}'
	else
		if ! herdr agent start "$name" --kind "$kind" --pane "$pane" --timeout 120000 -- "${cli_args[@]}" \
			>"$out/start.json" 2>&1; then
			herdr pane read "$pane" --source recent-unwrapped --lines 60 >"$out/screen.txt" 2>/dev/null || true
			echo "lane: $name did not start; pane $pane left open. Screen: $out/screen.txt" >&2
			exit 1
		fi
		target="$name"
		# --wait watches from the submission on. A prompt swallowed by a startup dialog, which herdr
		# reports as idle, fails fast as agent_prompt_stalled instead of passing as a finished turn.
		res="$(herdr agent prompt "$name" "$prompt" --wait --until idle --until "done" --until blocked \
			--timeout "$(slice)" 2>&1 || true)"
	fi

	state=timeout
	while ((SECONDS < deadline)); do
		[[ -n "$res" ]] || res="$(herdr agent wait "$target" --until idle --until "done" --until blocked \
			--timeout "$(slice)" 2>&1 || true)"
		echo "$res" >>"$out/wait.jsonl"
		err="$(jq -r '.error.code // empty' <<<"$res" 2>/dev/null || echo unparsable)"
		if [[ "$err" == timeout ]]; then res=""; continue; fi
		if [[ -n "$err" ]]; then state="error:$err"; break; fi
		state="$(jq -r '.result.agent.agent_status' <<<"$res")"
		if [[ -n "$seq0" && "$state" == idle && "$(jq -r '.result.agent.state_change_seq' <<<"$res")" -le "$seq0" ]]; then
			res=""
			sleep 2
			continue
		fi
		break
	done
	herdr agent read "$target" --source recent-unwrapped --lines 400 >"$out/screen.txt" 2>/dev/null || true
	# herdr matches a permission dialog line by line, and in a narrow pane the agent wraps it into
	# fragments ("Esc / to / can / cel") that no rule sees, so herdr reports idle. Matching the
	# screen with all whitespace removed finds the dialog however it wrapped.
	if [[ "$state" == idle ]] && tail -n 60 "$out/screen.txt" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]' |
		grep -qE 'doyouwanttoproceed|esctocancel|waitingforpermission|doyouwanttoallow'; then
		state=blocked
	fi
fi

success=false
[[ "$state" =~ ^(idle|done)$ ]] && report_written && success=true

where_note=""
if [[ "$where" != headless ]]; then
	closing=false
	case "$close" in
		auto) [[ "$state" =~ ^(idle|done)$ ]] && closing=true ;;
		on-success) $success && closing=true ;;
	esac
	if $closing; then
		if [[ "$where" == tab ]]; then herdr tab close "$tab" >/dev/null; else herdr pane close "$pane" >/dev/null; fi
		where_note=", $where closed"
	else
		where_note=", $where $([[ "$where" == tab ]] && echo "$tab" || echo "$pane") kept"
	fi
fi

result="$state"
[[ "$state" =~ ^(idle|done)$ ]] && ! report_written && result="$state without report"
echo "lane: $name $result after $((SECONDS - start)) s$where_note${report:+, report: $report}, log: $out" >&2
if $success; then exit 0; fi
case "$state" in
	blocked) exit 4 ;;
	timeout) exit 5 ;;
	*) exit 1 ;;
esac
