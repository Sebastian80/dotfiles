# Ghostty profile for the Herdr launcher (herdr.desktop).
#
# Loads the shared config, then strips Ghostty's own chrome: Herdr draws its own
# tabs, splits and sidebar, so the GTK header bar and Ghostty's tab bar only cost
# rows. KWin's title bar stays for minimize/maximize/close. Runs as its own GTK instance
# (separate class) so the panel groups it under herdr.desktop, not under Ghostty.
#
# Launch by hand:  ghostty --config-file=~/.config/ghostty/herdr
# (the shared ~/.config/ghostty/config is loaded first; this file only overrides)
#
# Testing a variant: pass the overrides as a SECOND config file,
#   ghostty --config-file=~/.config/ghostty/herdr --config-file=/path/override
# and check the window's class first (KWin: Alt+F3 > More Actions > Configure Special
# Window Settings, "Detect Window Properties"). A --class flag given before a
# --config-file is overridden by this file's class (includes load after CLI flags),
# and gtk-single-instance then hands the "test" window to the live Herdr instance.

class = com.mitchellh.ghostty.herdr
gtk-single-instance = true
# Fixed caption: herdr-launch finds the open window by this exact title.
title = Herdr

# KWin draws the title bar (Nordic Aurorae) instead of Ghostty's GTK header bar.
window-decoration = server
window-show-tab-bar = never
gtk-titlebar = false
# The shared config merges the tab bar into the header bar (tabs style); that header
# survives gtk-titlebar = false. Native style lets the decoration setting drop it.
gtk-titlebar-style = native
maximize = true
window-save-state = never

# Always ask before closing: the shared config skips the prompt, but this window
# hosts every agent pane. Closing only detaches the client, yet a stray Alt+F4
# should not do it silently. "always" ignores shell-integration process detection,
# which is unavailable through the bash wrapper anyway.
confirm-close-surface = always

# Herdr attaches to its persistent session; when it exits, the window goes with it.
# Launched from the panel, Ghostty only has the desktop session's environment, and
# ~/.bashrc bails out for non-interactive shells. An interactive login bash runs the
# full profile (PATH, fnm, aliases) and hands its environment to herdr via exec.
command = /bin/bash -lic "exec herdr"

# Hide or show the title bar for this window.
keybind = ctrl+shift+d=toggle_window_decorations
# Toggle maximize by hand, e.g. after un-maximizing to share the screen.
keybind = ctrl+shift+m=toggle_maximize

# Ghostty tabs and splits would each start a second herdr client attached to the
# same session. Unbind them so the keys reach Herdr, which owns tabs and splits.
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+w=unbind
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+page_up=unbind
keybind = ctrl+page_down=unbind
keybind = ctrl+shift+arrow_left=unbind
keybind = ctrl+shift+arrow_right=unbind
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind
