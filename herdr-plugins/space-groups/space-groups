#!/usr/bin/env python3
"""Tag every herdr Space with its project group, for the $group sidebar token.

  space-groups           tag all Spaces, print only what changed
  space-groups --list    show the resolved mapping without writing
  space-groups --clear   remove the tokens this tool set

herdr has no grouped-tree sidebar: ui.sidebar.*.rows renders a flat list of
tokens per entry. What it does have is $name custom tokens fed by
`herdr workspace report-metadata`, so a group label can sit on every row even
though a collapsible header cannot. This reports that label.

The tokens are runtime state and do not survive a herdr restart, which is why
the manifest also runs this as a startup hook.
"""
import fnmatch
import json
import os
import subprocess
import sys
import tomllib

SOURCE = "space-groups"
HERDR = os.environ.get("HERDR_BIN_PATH", "herdr")
HERE = os.path.dirname(os.path.abspath(__file__))


def herdr(*args):
    """Run a herdr command and return its parsed result, or None."""
    p = subprocess.run([HERDR, *args], capture_output=True, text=True)
    if p.returncode != 0:
        print(f"space-groups: `herdr {' '.join(args)}` failed: "
              f"{(p.stderr or p.stdout).strip()}", file=sys.stderr)
        return None
    try:
        return json.loads(p.stdout).get("result")
    except (json.JSONDecodeError, AttributeError):
        return {}


def load_patterns():
    with open(os.path.join(HERE, "groups.toml"), "rb") as fh:
        raw = tomllib.load(fh).get("groups", {})
    # Longest pattern first, so a specific path beats a general one.
    return sorted(((os.path.expanduser(k), v) for k, v in raw.items()),
                  key=lambda kv: -len(kv[0]))


def workspace_dirs():
    """Map each workspace to the cwd of its first pane."""
    panes = (herdr("pane", "list") or {}).get("panes", [])
    dirs = {}
    for pane in sorted(panes, key=lambda p: p.get("pane_id", "")):
        ws = pane.get("workspace_id")
        cwd = pane.get("cwd") or pane.get("foreground_cwd")
        if ws and cwd:
            dirs.setdefault(ws, cwd)
    return dirs


def resolve(patterns, cwd):
    for pattern, group in patterns:
        if fnmatch.fnmatch(cwd, pattern):
            return group
    return None


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg in ("-h", "--help"):
        print(__doc__)
        return 0

    labels = {w["workspace_id"]: w.get("label", "")
              for w in (herdr("workspace", "list") or {}).get("workspaces", [])}
    if not labels:
        print("space-groups: no workspaces reported", file=sys.stderr)
        return 1

    patterns = load_patterns()
    dirs = workspace_dirs()
    untagged = []

    for ws, label in labels.items():
        cwd = dirs.get(ws)
        group = resolve(patterns, cwd) if cwd else None

        if arg == "--clear":
            herdr("workspace", "report-metadata", ws,
                  "--source", SOURCE, "--clear-token", "group")
            continue
        if arg == "--list":
            print(f"  {ws:4} {label:24} {cwd or '(no pane cwd)':46} -> {group or '-'}")
            continue

        if group is None:
            untagged.append(f"{label or ws} ({cwd or 'no cwd'})")
            continue
        herdr("workspace", "report-metadata", ws,
              "--source", SOURCE, "--token", f"group={group}")

    if arg == "--clear":
        print(f"space-groups: cleared {len(labels)} Spaces")
    elif arg != "--list":
        print(f"space-groups: tagged {len(labels) - len(untagged)}/{len(labels)} Spaces")
        for name in untagged:
            print(f"  no pattern matched: {name}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
