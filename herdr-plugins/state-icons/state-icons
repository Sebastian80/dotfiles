#!/usr/bin/env python3
"""Publish "<glyph> <workspace>" per agent as the $line pane token.

  state-icons            refresh every agent pane
  state-icons --clear    remove the token

The glyphs are Nerd Font private-use codepoints and need a Nerd Font in the
terminal; Ghostty here runs JetBrainsMono Nerd Font. Colour comes from rules in
the row definition in config.toml, matched on the glyph's value, so both the
glyph and its colour are changed there, not here.
"""
import json
import os
import subprocess
import sys

HERDR = os.environ.get("HERDR_BIN_PATH", "herdr")
SOURCE = "state-icons"

# Option A: cog, bell, check, hollow circle, question-circle.
GLYPH = {  # written as escapes: literal private-use glyphs get stripped by some tool layers
    "working": "\uf013",  # cog
    "blocked": "\uf0f3",  # bell
    "done":    "\uf00c",  # check
    "idle":    "\uf10c",  # hollow circle
    "unknown": "\uf059",  # question-circle
}


def agents():
    p = subprocess.run([HERDR, "agent", "list"], capture_output=True, text=True)
    if p.returncode != 0:
        print(f"state-icons: agent list failed: {p.stderr.strip()}", file=sys.stderr)
        return []
    return json.loads(p.stdout).get("result", {}).get("agents", [])


def state_of(agent):
    status = agent.get("agent_status") or "unknown"
    # herdr reports finished-but-unseen work as done; older paths fold it into
    # idle with seen=false. Treat both the same.
    if status == "idle" and agent.get("seen") is False:
        status = "done"
    return status if status in GLYPH else "unknown"


def workspace_labels():
    p = subprocess.run([HERDR, "workspace", "list"], capture_output=True, text=True)
    if p.returncode != 0:
        return {}
    return {w["workspace_id"]: w.get("label") or w["workspace_id"]
            for w in json.loads(p.stdout).get("result", {}).get("workspaces", [])}


def main():
    clear = "--clear" in sys.argv[1:]
    if "-h" in sys.argv or "--help" in sys.argv:
        print(__doc__)
        return 0
    # Glyph and workspace name share one token. herdr puts " . " between any
    # two custom values on a row, and only its own state_icon gets a bare
    # space, so two tokens would read "<glyph> . name". One token loses the
    # separator; the rules in config.toml colour it with starts_with.
    labels = workspace_labels()
    n = 0
    for a in agents():
        line = f"{GLYPH[state_of(a)]} {labels.get(a.get('workspace_id'), a.get('workspace_id'))}"
        args = ["--clear-token", "line", "--clear-token", "icon"] if clear else ["--token", f"line={line}"]
        subprocess.run([HERDR, "pane", "report-metadata", a["pane_id"], "--source", SOURCE, *args],
                       capture_output=True)
        n += 1
    print(f"state-icons: {'cleared' if clear else 'set'} {n} agents")
    return 0


if __name__ == "__main__":
    sys.exit(main())
