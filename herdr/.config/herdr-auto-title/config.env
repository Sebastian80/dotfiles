# Herdr Auto Title (kryptamine/herdr-auto-title) - read once at plugin startup.
# Herdr starts plugins only when the server restores a session, so a change here
# takes effect after `herdr server stop` (which also ends every pane process).
# Unset lines keep the plugin's defaults; see config.env.example in the plugin repo.

# Titles are just "<context> › <activity>": the tab bar already shows the
# position, and the agent kind is visible on the pane border.
HERDR_AUTO_TITLE_POSITION=false
HERDR_AUTO_TITLE_AGENT_NAME=false

# Long enough that a Claude session topic is not cut mid-word.
HERDR_AUTO_TITLE_MAX_LENGTH=70
