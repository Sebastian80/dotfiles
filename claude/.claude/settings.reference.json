{
  "cleanupPeriodDays": 30,
  "env": {
    "BASH_ENV": "/home/sebastian/.bash/path.bash",
    "BASH_DEFAULT_TIMEOUT_MS": "60000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "MCP_TIMEOUT": "120000",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "10",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "50",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Skill"
    ],
    "deny": [
      "Read(.env*)",
      "Read(*.env)",
      "Read(*credentials*)",
      "Read(*secret*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.env.jira)",
      "Edit(.env*)",
      "Edit(*.env)",
      "Edit(*credentials*)",
      "Edit(*secret*)",
      "Bash(mkfs*)",
      "Bash(fdisk*)",
      "Bash(parted*)",
      "Bash(dd)",
      "Bash(dd *)",
      "Bash(sudo*)",
      "Bash(su)",
      "Bash(su *)",
      "Bash(doas)",
      "Bash(doas *)",
      "Bash(sh -c *)",
      "Bash(bash -c *)",
      "Bash(zsh -c *)",
      "Bash(eval *)",
      "Bash(exec *)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.env.jira)",
      "Bash(* .env*)",
      "Bash(*/.env*)",
      "Bash(*.env.jira*)",
      "Bash(*.ssh/*)",
      "Bash(*.aws/*)",
      "Bash(*.gnupg/*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)"
    ],
    "ask": [
      "Bash(glab mr merge *)",
      "Bash(glab mr close *)",
      "Bash(glab mr rebase *)",
      "Bash(glab * delete *)",
      "Bash(glab api * DELETE *)",
      "Bash(glab api * DELETE)",
      "Bash(glab repo archive *)",
      "Bash(glab auth login *)",
      "Bash(glab auth logout *)",
      "Bash(ddev delete *)",
      "Bash(ddev clean *)",
      "Bash(ddev poweroff *)",
      "Bash(ddev stop --remove-data*)",
      "Bash(ddev stop * --remove-data*)",
      "Bash(ddev snapshot restore *)",
      "Bash(ddev import-db *)",
      "Bash(ddev import-files *)",
      "Bash(make behat-install *)",
      "Bash(make deploy *)",
      "Bash(make migrate *)",
      "Bash(make seed *)",
      "Bash(make install *)",
      "Bash(make reset *)",
      "Bash(make destroy *)",
      "Bash(make purge *)",
      "Bash(brew upgrade *)",
      "Bash(brew uninstall *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-1",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/sebastian/.claude/hooks/ide-first.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/bin/bash /home/sebastian/.claude/statusline-omp.sh"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "superpowers@superpowers-dev": true,
    "security-audit@netresearch-claude-code-marketplace": true,
    "german-technical-writing@netresearch-claude-code-marketplace": true,
    "jira-integration@netresearch-claude-code-marketplace": true,
    "agent-browser@agent-browser": true,
    "activity-detective@netresearch-marketplace": true,
    "netresearch-gitlab@netresearch-marketplace": true,
    "netresearch-jira@netresearch-marketplace": true,
    "tempo-timesheet-sync@netresearch-marketplace": false,
    "skill-repo@netresearch-claude-code-marketplace": true,
    "agent-harness@netresearch-claude-code-marketplace": false,
    "data-tools@netresearch-claude-code-marketplace": true,
    "markdown-to-pdf@netresearch-claude-code-marketplace": true,
    "netresearch-branding@netresearch-claude-code-marketplace": true,
    "php-modernization@netresearch-claude-code-marketplace": true,
    "retro@netresearch-claude-code-marketplace": true
  },
  "extraKnownMarketplaces": {
    "netresearch-claude-code-marketplace": {
      "source": {
        "source": "github",
        "repo": "netresearch/claude-code-marketplace"
      },
      "autoUpdate": true
    },
    "netresearch-marketplace": {
      "source": {
        "source": "git",
        "url": "git@git.netresearch.de:coding-ai/marketplace.git"
      },
      "autoUpdate": true
    },
    "agent-browser": {
      "source": {
        "source": "github",
        "repo": "vercel-labs/agent-browser"
      },
      "autoUpdate": true
    },
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    }
  },
  "language": "english",
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "plansDirectory": ".claude/plan",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "ghostty",
  "teammateMode": "in-process",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "ddev start, stop, status, list, describe, exec, ssh, restart, logs, mysql, snapshot, xdebug — local DDEV dev stack, no production impact",
      "Bash(rsync:*) for local DDEV sync tasks — local dev stack only",
      "Bash(glab:*) against git.netresearch.de — routine GitLab CLI usage across the org's namespaces, high frequency, no destructive denial history observed",
      "Local version-control operations — including history rewriting — inside a disposable clone under the session scratchpad directory, where nothing is shared until it is pushed"
    ],
    "soft_deny": [
      "$defaults",
      "gcloud destructive/write subcommands (delete, deployments update, iam) — no established prod-safe carve-out; treat as soft block pending review",
      "Force-pushing or deleting a branch other people build on, and rewriting already-published history — destructive but clearable when the user has asked for it in this conversation"
    ]
  }
}
